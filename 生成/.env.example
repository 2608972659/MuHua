# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填入你自己的密钥
#   cp .env.example .env
# ============================================

# ---------- Elasticsearch ----------
ES_PASSWORD=jVaWERJ2oLooSJbdje1M

# ---------- DeepSeek API ----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 本地 Embedding 模型 ----------
# 模型名（HuggingFace 模型 ID 或本地路径）
EMB_MODEL=BAAI/bge-base-zh-v1.5
# 推理设备：cpu / cuda / cuda:0 等
EMB_DEVICE=cpu
